FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN addgroup --system audit && adduser --system --ingroup audit audit

COPY pyproject.toml LICENSE readme.md ./
COPY src ./src

RUN python -m pip install --no-cache-dir ".[web]"

USER audit
EXPOSE 8765

CMD ["spotify_to_tidal_web", "--host", "0.0.0.0", "--port", "8765"]
