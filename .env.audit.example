# Public origin used by the browser. HTTPS is required except on loopback.
AUDIT_WEB_BASE_URL=http://127.0.0.1:8765

# Spotify PKCE needs only a Client ID. Register this exact redirect URI:
# http://127.0.0.1:8765/auth/spotify/callback
SPOTIFY_CLIENT_ID=replace-with-your-client-id

# Create a Tidal Developer application. Its secret remains on the server.
TIDAL_CLIENT_ID=replace-with-your-client-id
TIDAL_CLIENT_SECRET=replace-with-your-client-secret

# Optional audit/session settings.
AUDIT_WEB_SESSION_TTL_SECONDS=7200
AUDIT_TIMESTAMP_MISMATCH_DAYS=30
AUDIT_TIMESTAMP_CLUSTER_SIZE=3
